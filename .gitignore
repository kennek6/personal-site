/_site/
/.quarto/

# Stray output from rendering a single file instead of the whole project.
/*.html
/*_files/

# ...but this one must be committed. It is generated by the pre-render script,
# and Quarto resolves {{< include >}} *before* pre-render runs — so a fresh
# clone (including the CI runner) cannot build without it already in the repo.
!_pub-entries.html

**/*.quarto_ipynb
__pycache__/

